# Postgres из docker-compose (docker compose up -d)
DATABASE_URL=postgresql://delivery:delivery@localhost:5432/delivery_tracker
# >=32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-plus-character-secret00
# >=32 символов, тот же генератор; используется Caddy on-demand TLS ask
INTERNAL_TOKEN=replace-with-32-plus-character-secret0
# Серверный токен Mapbox (Directions + Geocoding); пустой = preview/geocode отключены
MAPBOX_TOKEN=
# Базовый URL админки; обязателен в production
PUBLIC_BASE=http://localhost:3000
# Каталог загрузок; дефолт <cwd>/uploads
#STORAGE_ROOT=
NODE_ENV=development
