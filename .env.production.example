# Скопируй в .env.production и заполни реальными значениями.
# НИКОГДА не коммить .env.production в git.

# Домен для Caddy (должен быть настроен A-record → IP сервера)
ADMIN_DOMAIN=admin.example.com

# Пароль postgres в контейнере
POSTGRES_PASSWORD=<replace-with-strong-password>

# Строка подключения к postgres внутри docker-сети (хост postgres, не localhost)
DATABASE_URL=postgresql://delivery:<POSTGRES_PASSWORD>@postgres:5432/delivery_tracker

# Секрет для подписи JWT (минимум 32 случайных байта, hex или base64)
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<replace-with-random-hex>

# Токен Mapbox для HOS-симулятора (серверный, не публичный)
MAPBOX_TOKEN=pk.eyJ1...

# Внутренний токен для Caddy → API on-demand TLS (минимум 32 символа, hex)
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OPERATOR: если в .env.production уже есть INTERNAL_AUTH_TOKEN — переименуйте его в INTERNAL_TOKEN
INTERNAL_TOKEN=<replace-with-random-hex-min-32-chars>
