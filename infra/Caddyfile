{
  email admin@bluestarautotransport.com

  on_demand_tls {
    ask http://api:3000/internal/validate-domain
  }
}

# Админ-кабинет — фиксированный домен, обычный TLS
admin.bluestarautotransport.com {
  encode gzip zstd

  handle_path /api/* {
    reverse_proxy api:3000
  }

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle {
    reverse_proxy web:80
  }
}

# Share-страницы — любой брендовый домен, on-demand TLS
:443 {
  tls {
    on_demand
  }

  encode gzip zstd

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle_path /api/* {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:80
  }
}
