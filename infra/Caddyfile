{
  email admin@bluestarautotransport.com

  on_demand_tls {
    ask http://api:3000/internal/validate-domain?token={env.INTERNAL_TOKEN}
  }
}

# Админ-кабинет — фиксированный домен, обычный TLS
admin.bluestarautotransport.com {
  encode gzip zstd

  # Block internal API before any catch-all forwards — public internet must never
  # reach /api/internal/* even if Caddy receives a crafted request on this domain.
  @internal path /api/internal/*
  handle @internal {
    respond "Not Found" 404
  }

  handle_path /api/* {
    reverse_proxy api:3000
  }

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle {
    reverse_proxy web:80
  }
}

# Share-страницы — любой брендовый домен, on-demand TLS.
# Только /s/<hash> + assets открыты; всё остальное 404, чтобы
# на брендовом домене была доступна исключительно share-страница.
:443 {
  tls {
    on_demand
  }

  encode gzip zstd

  # Block internal API on brand domains too — defense-in-depth.
  @internal path /api/internal/*
  handle @internal {
    respond "Not Found" 404
  }

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle_path /api/* {
    reverse_proxy api:3000
  }

  @share path /s/* /assets/* /favicon.svg
  handle @share {
    reverse_proxy web:80
  }

  handle {
    respond "Not Found" 404
  }
}
